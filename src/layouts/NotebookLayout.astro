---
import '../styles/site.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-custom-cursor="true" data-edge-rules="true" data-horizontal-rules="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="personal technical notebook by william kiem lafond" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-cursor" data-cursor aria-hidden="true"><span></span></div>
    <slot />
  </body>
</html>

<script>
  import { createDialKit, createDialRoot } from 'dialkit/vanilla';
  import 'dialkit/vanilla/styles.css';

  const displayFonts: Record<string, string> = {
    'Libre Baskerville': "'Libre Baskerville', Baskerville, Georgia, serif",
    Georgia: "Georgia, 'Times New Roman', serif",
    'Instrument Serif': "'Instrument Serif', Georgia, serif",
  };
  const bodyFonts: Record<string, string> = {
    'DM Sans': "'DM Sans', Arial, sans-serif",
    Arial: 'Arial, Helvetica, sans-serif',
    'Be Vietnam Pro': "'Be Vietnam Pro', Arial, sans-serif",
  };

  createDialRoot({ position: 'bottom-right', theme: 'light', versions: 'thumbnails', productionEnabled: true });
  const kit = createDialKit('Landing page', {
    Type: {
      display: { type: 'select', options: ['Libre Baskerville', 'Georgia', 'Instrument Serif'] },
      body: { type: 'select', options: ['DM Sans', 'Arial', 'Be Vietnam Pro'] },
      titleSize: [67, 44, 120, 1], titleTracking: [2, -6, 4, 0.1], bodySize: [16, 12, 20, 1], lineHeight: [1.5, 1.1, 2, 0.05],
    },
    Color: { paper: '#f4f1e8', ink: '#34342f', mutedInk: '#74746c', accent: '#aab500', accentSoft: '#d6db70', rule: '#a7a79e' },
    Layout: { canvasWidth: [1392, 800, 1680, 8], pageInset: [34, 16, 96, 2], topSpace: [32, 16, 120, 2] },
    Details: {
      grain: [0.2, 0, 0.3, 0.005], grainSize: [220, 48, 300, 4],
      ruleStyle: { type: 'select', options: ['dashed', 'dotted', 'solid'] }, ruleOpacity: [0.45, 0.1, 1, 0.01],
      horizontalRules: true, edgeRules: true,
    },
    Cursor: {
      enabled: true,
      size: [17, 10, 28, 1],
      barWidth: [4, 1, 7, 0.5],
      barHeight: [30, 17, 48, 1],
      crossSize: [30, 17, 48, 1],
      morphDuration: [220, 60, 500, 10],
      follow: [0.55, 0.15, 1, 0.05],
    },
    Spatial: {
      cameraDuration: [1050, 400, 2200, 50],
      cameraEase: { type: 'select', options: ['exponential', 'smooth', 'snappy'] },
      junctionPause: [90, 0, 500, 10],
      trackThickness: [1, 0.5, 4, 0.5],
      stationSize: [12, 6, 24, 1],
      guideColumnWidth: [196, 100, 360, 4],
      guideOpacity: [0.45, 0.1, 1, 0.05],
      horizontalGuidePosition: [34, 20, 70, 1],
      centerContent: true,
      showGuides: true,
      routeThroughHome: true,
      lockHorizontalGestures: true,
    },
    Motion: { linkShift: [0, 0, 12, 1], elevatorDuration: [560, 120, 1200, 20], detailBlur: [6, 0, 18, 1] },
    Copy: { title: 'William Kiem Lafond', introduction: 'this is a notebook for things i learn by building.' },
  }, { id: 'personal-site-v6', persist: true });

  let cursorFollow = 0.55;

  kit.subscribe((values) => {
    const style = document.documentElement.style;
    style.setProperty('--font-display', displayFonts[values.Type.display] ?? displayFonts['Libre Baskerville']);
    style.setProperty('--font-body', bodyFonts[values.Type.body] ?? bodyFonts['DM Sans']);
    style.setProperty('--color-paper', values.Color.paper); style.setProperty('--color-ink', values.Color.ink);
    style.setProperty('--color-ink-muted', values.Color.mutedInk); style.setProperty('--color-accent', values.Color.accent);
    style.setProperty('--color-accent-soft', values.Color.accentSoft); style.setProperty('--color-rule-custom', values.Color.rule); style.setProperty('--title-size', `${values.Type.titleSize}px`);
    style.setProperty('--title-tracking', `${values.Type.titleTracking}px`); style.setProperty('--body-size', `${values.Type.bodySize}px`);
    style.setProperty('--body-leading', String(values.Type.lineHeight)); style.setProperty('--canvas-width', `${values.Layout.canvasWidth}px`);
    style.setProperty('--page-inset', `${values.Layout.pageInset}px`); style.setProperty('--top-space', `${values.Layout.topSpace}px`);
    style.setProperty('--grain-opacity', String(values.Details.grain)); style.setProperty('--grain-size', `${values.Details.grainSize}px`);
    style.setProperty('--rule-style', values.Details.ruleStyle); style.setProperty('--rule-opacity', String(values.Details.ruleOpacity));
    style.setProperty('--link-shift', `${values.Motion.linkShift}px`); style.setProperty('--elevator-duration', `${values.Motion.elevatorDuration}ms`);
    const cameraEases: Record<string, string> = {
      exponential: 'cubic-bezier(.87, 0, .13, 1)',
      smooth: 'cubic-bezier(.65, 0, .35, 1)',
      snappy: 'cubic-bezier(.8, 0, .2, 1)',
    };
    style.setProperty('--detail-blur', `${values.Motion.detailBlur}px`);
    style.setProperty('--camera-duration', `${values.Spatial.cameraDuration}ms`); style.setProperty('--camera-ease', cameraEases[values.Spatial.cameraEase] ?? cameraEases.exponential);
    style.setProperty('--junction-pause', `${values.Spatial.junctionPause}ms`);
    style.setProperty('--track-thickness', `${values.Spatial.trackThickness}px`);
    style.setProperty('--station-size', `${values.Spatial.stationSize}px`); style.setProperty('--guide-column-width', `${values.Spatial.guideColumnWidth}px`);
    style.setProperty('--guide-opacity', String(values.Spatial.guideOpacity)); style.setProperty('--horizontal-guide-position', `${values.Spatial.horizontalGuidePosition}%`);
    style.setProperty('--cursor-size', `${values.Cursor.size}px`); style.setProperty('--cursor-bar-width', `${values.Cursor.barWidth}px`);
    style.setProperty('--cursor-bar-height', `${values.Cursor.barHeight}px`); style.setProperty('--cursor-cross-size', `${values.Cursor.crossSize}px`);
    style.setProperty('--cursor-morph-duration', `${values.Cursor.morphDuration}ms`);
    cursorFollow = values.Cursor.follow;
    document.documentElement.dataset.horizontalRules = String(values.Details.horizontalRules);
    document.documentElement.dataset.edgeRules = String(values.Details.edgeRules);
    document.documentElement.dataset.customCursor = String(values.Cursor.enabled);
    document.documentElement.dataset.centerContent = String(values.Spatial.centerContent);
    document.documentElement.dataset.showGuides = String(values.Spatial.showGuides);
    document.documentElement.dataset.routeThroughHome = String(values.Spatial.routeThroughHome);
    document.documentElement.dataset.lockHorizontalGestures = String(values.Spatial.lockHorizontalGestures);
    document.querySelectorAll<HTMLElement>('[data-site-title]').forEach((node) => { node.textContent = values.Copy.title.toLowerCase(); });
    document.querySelectorAll<HTMLElement>('[data-site-intro]').forEach((node) => { node.textContent = values.Copy.introduction.toLowerCase(); });
  });

  const cursor = document.querySelector<HTMLElement>('[data-cursor]');
  let targetX = -100;
  let targetY = -100;
  let currentX = -100;
  let currentY = -100;
  let cursorFrame = 0;

  const renderCursor = () => {
    currentX += (targetX - currentX) * cursorFollow;
    currentY += (targetY - currentY) * cursorFollow;
    if (cursor) cursor.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
    if (Math.abs(targetX - currentX) > 0.02 || Math.abs(targetY - currentY) > 0.02) cursorFrame = requestAnimationFrame(renderCursor);
    else cursorFrame = 0;
  };
  const queueCursor = () => { if (!cursorFrame) cursorFrame = requestAnimationFrame(renderCursor); };
  const textSelector = 'p,h1,h2,h3,span,strong,small,cite,blockquote,label,li,code,pre';
  const clickableSelector = 'a,button,[role="button"],[role="tab"],input,textarea,select,summary';

  document.addEventListener('pointermove', (event) => {
    targetX = event.clientX;
    targetY = event.clientY;
    if (currentX < -50) { currentX = targetX; currentY = targetY; }
    cursor?.classList.add('is-visible');
    queueCursor();
  }, { passive: true });
  document.addEventListener('pointerover', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const state = target?.closest(clickableSelector) ? 'clickable' : target?.closest(textSelector) ? 'text' : 'default';
    if (cursor) cursor.dataset.state = state;
  }, { passive: true });
  document.addEventListener('pointerdown', () => cursor?.classList.add('is-pressed'), { passive: true });
  document.addEventListener('pointerup', () => cursor?.classList.remove('is-pressed'), { passive: true });
  document.documentElement.addEventListener('mouseleave', () => cursor?.classList.remove('is-visible'));
  window.addEventListener('blur', () => cursor?.classList.remove('is-visible'));

</script>
