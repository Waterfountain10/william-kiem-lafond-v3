---
import BaseLayout from '../layouts/BaseLayout.astro';

import '@fontsource/instrument-serif/400.css';
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
---

<BaseLayout title="william kiem lafond">
  <div class="site-shell">
    <header class="site-rail">
      <a class="name-link animated-link" href="#whoami" aria-label="home">william kiem lafond</a>
      <nav aria-label="primary navigation">
        <a class="is-active" href="#whoami"><span aria-hidden="true">·</span> whoami</a>
        <a href="#writings"><span aria-hidden="true">·</span> writings</a>
        <a href="#projects"><span aria-hidden="true">·</span> projects</a>
        <a href="#guestbook"><span aria-hidden="true">·</span> guestbook</a>
      </nav>
      <p class="rail-note">a notebook on software,<br />systems, and making.</p>
    </header>

    <main>
      <section class="whoami" id="whoami" aria-labelledby="page-title">
        <div class="intro-copy">
          <p class="eyebrow">whoami</p>
          <h1 id="page-title">
            <span data-dial-title>william kiem lafond</span> is a <em>systems engineer</em>.
          </h1>
          <p class="lede" data-dial-intro>this is a notebook for things i learn by building.</p>
        </div>

        <div class="art-placeholder" aria-label="placeholder for a hand-drawn asset">
          <span>your ink drawing</span>
          <div class="wire-cube" aria-hidden="true"><i></i></div>
        </div>

        <div class="experience-copy" aria-label="experience">
          <p>
            worked on machine learning algorithms at <a class="company-link" href="https://www.shopify.com/" target="_blank" rel="noreferrer">shopify<span aria-hidden="true">↗</span></a>.
          </p>
          <p>
            fine-tuned cpu compilers at <a class="company-link" href="https://www.qualcomm.com/" target="_blank" rel="noreferrer">qualcomm<span aria-hidden="true">↗</span></a>.
          </p>
          <p>
            researched applied rag at <a class="company-link" href="https://mila.quebec/en" target="_blank" rel="noreferrer">mila<span aria-hidden="true">↗</span></a>.
          </p>
        </div>

        <blockquote>
          <p>“we think systems, but we also have an eye for aesthetics.”</p>
          <cite>— vlad, good friend &amp; college roommate</cite>
        </blockquote>
      </section>

      <div class="full-rule" aria-hidden="true"></div>

      <section class="index-section writings-section" id="writings" aria-labelledby="writings-title">
        <div class="section-heading">
          <p class="section-number">01</p>
          <h2 id="writings-title">writings</h2>
        </div>
        <div class="section-content writing-elevator" data-writing-elevator>
          <div class="writing-list" role="tablist" aria-label="writing selection">
            <div class="elevator-rail" aria-hidden="true"><span class="elevator-car"></span></div>
            <button class="writing-card is-selected" type="button" role="tab" aria-selected="true" aria-controls="writing-detail-1" data-writing-tab="0">
              <span class="writing-index">writing 01</span>
              <strong>title pending</strong>
              <small>topic · date</small>
            </button>
            <button class="writing-card" type="button" role="tab" aria-selected="false" aria-controls="writing-detail-2" data-writing-tab="1">
              <span class="writing-index">writing 02</span>
              <strong>title pending</strong>
              <small>topic · date</small>
            </button>
            <button class="writing-card" type="button" role="tab" aria-selected="false" aria-controls="writing-detail-3" data-writing-tab="2">
              <span class="writing-index">writing 03</span>
              <strong>title pending</strong>
              <small>topic · date</small>
            </button>
          </div>

          <div class="writing-stage" aria-live="polite">
            <article class="writing-detail is-visible" id="writing-detail-1" role="tabpanel" data-writing-panel="0">
              <div class="detail-art">ink drawing / thumbnail</div>
              <p class="micro-label">selected writing · 01</p>
              <h3>title pending</h3>
              <p>an excerpt or short description can fade into this space once the first piece is ready.</p>
            </article>
            <article class="writing-detail" id="writing-detail-2" role="tabpanel" data-writing-panel="1" hidden>
              <div class="detail-art">diagram / animation</div>
              <p class="micro-label">selected writing · 02</p>
              <h3>title pending</h3>
              <p>this space can hold an explanatory sketch, a systems diagram, or a quiet text preview.</p>
            </article>
            <article class="writing-detail" id="writing-detail-3" role="tabpanel" data-writing-panel="2" hidden>
              <div class="detail-art">pixel art / note</div>
              <p class="micro-label">selected writing · 03</p>
              <h3>title pending</h3>
              <p>the final preview can combine a handwritten note with the article’s date and subject.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="index-section" id="projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <p class="section-number">02</p>
          <h2 id="projects-title">projects</h2>
        </div>
        <div class="section-content">
          <p class="section-note">selected engineering work, documented as it develops.</p>
          <div class="project-grid" aria-label="projects pending">
            <div><span>selected work</span><small>details pending</small></div>
            <div class="project-art"><span>your drawing here</span><small>ink / pixel / diagram</small></div>
          </div>
        </div>
      </section>

      <section class="index-section" id="guestbook" aria-labelledby="guestbook-title">
        <div class="section-heading">
          <p class="section-number">03</p>
          <h2 id="guestbook-title">guestbook</h2>
        </div>
        <div class="section-content guestbook-note">
          <p>leave a note when the guestbook opens.</p>
          <span class="muted">not wired yet</span>
        </div>
      </section>
    </main>

    <footer>
      <span>personal notebook</span>
      <span>set in <span data-font-label>libre baskerville + dm sans</span></span>
    </footer>
  </div>
</BaseLayout>

<script>
  import { createDialKit, createDialRoot } from 'dialkit/vanilla';
  import 'dialkit/vanilla/styles.css';

  const displayFonts: Record<string, string> = {
    Georgia: "Georgia, 'Times New Roman', serif",
    'Instrument Serif': "'Instrument Serif', Georgia, serif",
    'Libre Baskerville': "'Libre Baskerville', Baskerville, Georgia, serif",
  };
  const bodyFonts: Record<string, string> = {
    Arial: 'Arial, Helvetica, sans-serif',
    'Be Vietnam Pro': "'Be Vietnam Pro', Arial, sans-serif",
    'DM Sans': "'DM Sans', Arial, sans-serif",
  };

  createDialRoot({ position: 'bottom-right', theme: 'light', versions: 'thumbnails', productionEnabled: true });

  const kit = createDialKit(
    'Landing page',
    {
      Type: {
        display: { type: 'select', options: ['Libre Baskerville', 'Georgia', 'Instrument Serif'] },
        body: { type: 'select', options: ['DM Sans', 'Arial', 'Be Vietnam Pro'] },
        titleSize: [67, 44, 120, 1],
        titleTracking: [2, -6, 4, 0.1],
        bodySize: [16, 12, 20, 1],
        lineHeight: [1.5, 1.1, 2, 0.05],
      },
      Color: {
        paper: '#f4f1e8', ink: '#34342f', mutedInk: '#74746c', accent: '#aab500', rule: '#a7a79e',
      },
      Layout: {
        canvasWidth: [1392, 800, 1680, 8],
        pageInset: [34, 16, 96, 2],
        topSpace: [32, 16, 120, 2],
        introTop: [128, 48, 240, 4],
        introWidth: [800, 440, 1040, 10],
        sectionGap: [60, 32, 128, 4],
        navWidth: [196, 140, 300, 2],
      },
      Details: {
        grain: [0.16, 0, 0.2, 0.005],
        grainSize: [220, 48, 260, 4],
        ruleStyle: { type: 'select', options: ['dashed', 'dotted', 'solid'] },
        ruleOpacity: [0.45, 0.1, 1, 0.01],
        verticalRules: true, horizontalRules: true, edgeRules: true, showNumbers: true,
        squareCursor: true, cursorSize: [17, 6, 22, 1],
      },
      Motion: {
        linkShift: [4, 0, 12, 1],
        elevatorDuration: [560, 120, 1200, 20],
        detailBlur: [6, 0, 18, 1],
      },
      Copy: {
        title: 'William Kiem Lafond',
        introduction: 'this is a notebook for things i learn by building.',
      },
    },
    { id: 'personal-site-landing-v4', persist: true },
  );

  kit.subscribe((values) => {
    const style = document.documentElement.style;
    style.setProperty('--font-display', displayFonts[values.Type.display] ?? displayFonts['Libre Baskerville']);
    style.setProperty('--font-body', bodyFonts[values.Type.body] ?? bodyFonts['DM Sans']);
    style.setProperty('--color-paper', values.Color.paper);
    style.setProperty('--color-ink', values.Color.ink);
    style.setProperty('--color-ink-muted', values.Color.mutedInk);
    style.setProperty('--color-accent', values.Color.accent);
    style.setProperty('--color-rule-custom', values.Color.rule);
    style.setProperty('--title-size', `${values.Type.titleSize}px`);
    style.setProperty('--title-tracking', `${values.Type.titleTracking}px`);
    style.setProperty('--body-size', `${values.Type.bodySize}px`);
    style.setProperty('--body-leading', String(values.Type.lineHeight));
    style.setProperty('--canvas-width', `${values.Layout.canvasWidth}px`);
    style.setProperty('--page-inset', `${values.Layout.pageInset}px`);
    style.setProperty('--top-space', `${values.Layout.topSpace}px`);
    style.setProperty('--intro-top', `${values.Layout.introTop}px`);
    style.setProperty('--intro-width', `${values.Layout.introWidth}px`);
    style.setProperty('--section-gap', `${values.Layout.sectionGap}px`);
    style.setProperty('--nav-width', `${values.Layout.navWidth}px`);
    style.setProperty('--grain-opacity', String(values.Details.grain));
    style.setProperty('--grain-size', `${values.Details.grainSize}px`);
    style.setProperty('--rule-style', values.Details.ruleStyle);
    style.setProperty('--rule-opacity', String(values.Details.ruleOpacity));
    style.setProperty('--link-shift', `${values.Motion.linkShift}px`);
    style.setProperty('--elevator-duration', `${values.Motion.elevatorDuration}ms`);
    style.setProperty('--detail-blur', `${values.Motion.detailBlur}px`);

    const cursorSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="${values.Details.cursorSize}" height="${values.Details.cursorSize}"><rect width="100%" height="100%" fill="${values.Color.accent}"/></svg>`;
    style.setProperty('--site-cursor', `url("data:image/svg+xml,${encodeURIComponent(cursorSvg)}")`);
    document.documentElement.dataset.showNumbers = String(values.Details.showNumbers);
    document.documentElement.dataset.verticalRules = String(values.Details.verticalRules);
    document.documentElement.dataset.horizontalRules = String(values.Details.horizontalRules);
    document.documentElement.dataset.edgeRules = String(values.Details.edgeRules);
    document.documentElement.dataset.squareCursor = String(values.Details.squareCursor);

    const title = document.querySelector<HTMLElement>('[data-dial-title]');
    const introduction = document.querySelector<HTMLElement>('[data-dial-intro]');
    const fontLabel = document.querySelector<HTMLElement>('[data-font-label]');
    if (title) title.textContent = values.Copy.title.toLowerCase();
    if (introduction) introduction.textContent = values.Copy.introduction.toLowerCase();
    if (fontLabel) fontLabel.textContent = `${values.Type.display} + ${values.Type.body}`.toLowerCase();
  });

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-writing-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-writing-panel]'));
  const car = document.querySelector<HTMLElement>('.elevator-car');

  const selectWriting = (index: number) => {
    const selected = tabs[index];
    if (!selected || !car) return;
    tabs.forEach((tab, tabIndex) => {
      const active = tabIndex === index;
      tab.classList.toggle('is-selected', active);
      tab.setAttribute('aria-selected', String(active));
    });
    car.style.transform = `translateY(${selected.offsetTop + 18}px)`;
    panels.forEach((panel, panelIndex) => {
      const active = panelIndex === index;
      if (active) {
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add('is-visible'));
      } else {
        panel.classList.remove('is-visible');
        window.setTimeout(() => { if (!panel.classList.contains('is-visible')) panel.hidden = true; }, 600);
      }
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectWriting(index));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      const next = event.key === 'ArrowDown' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
      tabs[next]?.focus();
      selectWriting(next);
    });
  });
  requestAnimationFrame(() => selectWriting(0));

  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]'));
  const observedSections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => Boolean(section));
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      navLinks.forEach((link) => link.classList.toggle('is-active', link.hash === `#${visible.target.id}`));
    },
    { rootMargin: '-20% 0px -65% 0px', threshold: [0, 0.25, 0.6] },
  );
  observedSections.forEach((section) => sectionObserver.observe(section));
</script>

<style>
  :global(html) {
    --title-size: 67px; --title-tracking: 2px; --body-size: 16px; --body-leading: 1.5;
    --canvas-width: 1392px; --page-inset: 34px; --top-space: 32px; --intro-top: 128px;
    --intro-width: 800px; --section-gap: 60px; --nav-width: 196px; --grain-size: 220px;
    --color-rule-custom: #a7a79e; --rule-style: dashed; --rule-opacity: .45;
    --site-cursor: auto; --link-shift: 4px; --elevator-duration: 560ms; --detail-blur: 6px;
    scroll-behavior: smooth; font-size: var(--body-size); text-transform: lowercase;
  }
  :global(html[data-square-cursor='true']), :global(html[data-square-cursor='true'] *) { cursor: var(--site-cursor) 8 8, auto; }
  :global(::selection) { background: var(--color-accent); color: var(--color-ink); }
  :global(body) { min-width: 320px; overflow-x: hidden; background: var(--color-paper); }
  :global(body::before) { position:fixed;z-index:10;inset:0;pointer-events:none;content:'';opacity:var(--grain-opacity);background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 96 96' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");background-size:var(--grain-size) var(--grain-size); }

  .site-shell { display:grid;grid-template-columns:var(--nav-width) minmax(0,1fr);width:min(100%,var(--canvas-width));min-height:100vh;margin:auto;border-inline:1px var(--rule-style) color-mix(in srgb,var(--color-rule-custom) calc(var(--rule-opacity)*100%),transparent); }
  :global(html[data-edge-rules='false']) .site-shell { border-inline-color:transparent; }
  .site-rail { position:sticky;top:0;display:flex;height:100vh;flex-direction:column;align-items:flex-start;padding:var(--top-space) var(--page-inset);border-right:1px var(--rule-style) color-mix(in srgb,var(--color-rule-custom) calc(var(--rule-opacity)*100%),transparent);font-size:.7rem; }
  :global(html[data-vertical-rules='false']) .site-rail { border-right-color:transparent; }
  .name-link { color:var(--color-ink-muted);line-height:1.2;text-decoration:none; }
  nav { display:flex;flex-direction:column;gap:.45rem;margin-top:var(--intro-top); }
  nav a { position:relative;color:var(--color-ink-muted);text-decoration:none;transition:color 180ms ease,transform 240ms cubic-bezier(.2,.8,.2,1); }
  nav a span { display:inline-block;color:transparent;transition:color 180ms,transform 240ms; }
  nav a:hover,nav a.is-active { color:var(--color-accent);transform:translateX(var(--link-shift)); }
  nav a:hover span,nav a.is-active span { color:currentColor;transform:rotate(90deg) scale(1.4); }
  .rail-note { margin:auto 0 0;color:var(--color-ink-muted);font-family:var(--font-display);font-size:.7rem;font-style:italic;line-height:1.4; }

  main { min-width:0;padding:calc(var(--top-space) + var(--intro-top)) var(--page-inset) 0; }
  .whoami { display:grid;grid-template-columns:minmax(0,var(--intro-width)) minmax(160px,1fr);gap:clamp(2rem,6vw,7rem);align-items:start; }
  .eyebrow,.section-number,.micro-label { margin:0 0 var(--space-6);color:var(--color-ink-muted);font-size:.62rem;letter-spacing:.1em;text-transform:lowercase; }
  .eyebrow::before { display:inline-block;width:.42rem;height:.42rem;margin-right:var(--space-2);background:var(--color-accent);content:''; }
  h1 { max-width:18ch;margin:0;font-family:var(--font-display);font-size:clamp(3rem,5vw,var(--title-size));font-weight:400;letter-spacing:var(--title-tracking);line-height:1.05;text-wrap:balance; }
  h1 em { color:var(--color-accent);font-weight:inherit; }
  .lede { max-width:54ch;margin:var(--space-8) 0 0;color:var(--color-ink-muted);line-height:var(--body-leading); }
  .art-placeholder { display:flex;min-height:230px;flex-direction:column;align-items:center;justify-content:center;gap:24px;color:var(--color-ink-muted);font-size:.58rem;letter-spacing:.1em; }
  .wire-cube { position:relative;width:92px;height:112px;border:1px solid var(--color-accent); }
  .wire-cube::before { position:absolute;inset:-20px 20px 20px -20px;border:1px solid var(--color-accent);content:''; }
  .wire-cube i,.wire-cube i::before,.wire-cube i::after { position:absolute;width:28px;border-top:1px solid var(--color-accent);content:'';transform:rotate(-45deg);transform-origin:left; }
  .wire-cube i { top:0;left:0 }.wire-cube i::before{top:111px;left:91px}.wire-cube i::after{top:111px;left:0}
  .experience-copy { grid-column:1 / -1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-8);padding-top:var(--space-8);border-top:1px var(--rule-style) color-mix(in srgb,var(--color-rule-custom) calc(var(--rule-opacity)*100%),transparent);font-family:var(--font-display);font-size:1.05rem; }
  .experience-copy p { margin:0; }
  .company-link { position:relative;display:inline-block;color:var(--color-ink);text-decoration-color:var(--color-accent);transition:color 180ms,transform 240ms cubic-bezier(.2,.8,.2,1); }
  .company-link::before { position:absolute;z-index:-1;right:-3px;bottom:0;left:-3px;height:0;background:var(--color-accent);content:'';transition:height 220ms cubic-bezier(.2,.8,.2,1); }
  .company-link span { display:inline-block;margin-left:3px;transition:transform 240ms; }
  .company-link:hover { color:var(--color-ink);transform:translateY(calc(var(--link-shift)*-1)); }
  .company-link:hover::before { height:58%; }.company-link:hover span { transform:translate(3px,-3px); }
  blockquote { grid-column:2;max-width:28rem;margin:0;padding-left:var(--space-4);border-left:1px solid var(--color-accent); }
  blockquote p { margin:0;font-family:var(--font-display);font-style:italic; }
  blockquote cite { display:block;margin-top:var(--space-3);color:var(--color-ink-muted);font-size:.62rem;font-style:normal; }

  .full-rule { width:100vw;margin:var(--section-gap) 0 0 calc(50% - 50vw - var(--nav-width));border-top:1px var(--rule-style) var(--color-rule-custom);opacity:var(--rule-opacity); }
  .index-section { position:relative;display:grid;grid-template-columns:minmax(170px,.7fr) 2fr;gap:var(--space-8);margin-inline:calc(var(--page-inset)*-1);padding:var(--space-12) var(--page-inset); }
  .index-section::after { position:absolute;bottom:0;left:calc((50vw - 50%) * -1 - var(--nav-width));width:100vw;border-bottom:1px var(--rule-style) color-mix(in srgb,var(--color-rule-custom) calc(var(--rule-opacity)*100%),transparent);content:''; }
  :global(html[data-horizontal-rules='false']) .full-rule,:global(html[data-horizontal-rules='false']) .index-section::after { border-color:transparent; }
  .section-heading { display:grid;grid-template-columns:2rem auto;align-items:baseline;align-self:start; }
  .section-number { margin:0;font-size:.56rem; }:global(html[data-show-numbers='false']) .section-number{visibility:hidden}
  h2,h3 { margin:0;font-family:var(--font-display);font-weight:400; } h2{font-size:1.5rem}.section-note{margin:0 0 var(--space-8);color:var(--color-ink-muted);font-size:.76rem}

  .writing-elevator { display:grid;grid-template-columns:minmax(260px,.85fr) minmax(320px,1.15fr);gap:clamp(2rem,5vw,5rem); }
  .writing-list { position:relative;display:grid;gap:14px;padding-left:28px; }
  .elevator-rail { position:absolute;top:0;bottom:0;left:7px;width:1px;background:var(--color-accent); }
  .elevator-car { position:absolute;top:0;left:-6px;width:13px;height:13px;background:var(--color-accent);box-shadow:0 0 0 4px var(--color-paper);transition:transform var(--elevator-duration) cubic-bezier(.65,0,.2,1); }
  .writing-card { min-height:118px;padding:18px 20px;border:1px var(--rule-style) color-mix(in srgb,var(--color-rule-custom) calc(var(--rule-opacity)*100%),transparent);background:transparent;color:var(--color-ink);font:inherit;text-align:left;transition:border-color 240ms,box-shadow 240ms,transform 240ms,background 240ms; }
  .writing-card:hover { transform:translateX(var(--link-shift));border-color:var(--color-accent); }
  .writing-card.is-selected { border:2px solid var(--color-accent);background:color-mix(in srgb,var(--color-accent) 4%,transparent);box-shadow:4px 4px 0 color-mix(in srgb,var(--color-accent) 25%,transparent); }
  .writing-card span,.writing-card strong,.writing-card small{display:block}.writing-card .writing-index{color:var(--color-ink-muted);font-size:.58rem;letter-spacing:.1em}.writing-card strong{margin-top:20px;font-family:var(--font-display);font-size:1.15rem;font-weight:400}.writing-card small{margin-top:5px;color:var(--color-ink-muted);font-size:.62rem}
  .writing-stage { position:relative;min-height:382px;border:1px var(--rule-style) color-mix(in srgb,var(--color-rule-custom) calc(var(--rule-opacity)*100%),transparent);overflow:hidden; }
  .writing-detail { position:absolute;inset:0;padding:24px;opacity:0;filter:blur(var(--detail-blur));transform:translateY(12px);transition:opacity 420ms,filter 420ms,transform 420ms; }
  .writing-detail.is-visible { opacity:1;filter:blur(0);transform:translateY(0); }
  .detail-art { display:grid;height:190px;margin-bottom:24px;place-items:center;border:1px dashed var(--color-accent);color:var(--color-ink-muted);font-family:var(--font-display);font-size:.8rem;font-style:italic; }
