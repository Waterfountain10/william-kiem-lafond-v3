---
import BaseLayout from '../layouts/BaseLayout.astro';

import '@fontsource/instrument-serif/400.css';
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
---

<BaseLayout title="William Kiem-Lafond">
  <div class="site-shell">
    <header class="site-rail">
      <a class="name-link" href="#home" aria-label="Home">William Kiem-Lafond</a>
      <nav aria-label="Primary navigation">
        <a class="is-active" href="#home"><span aria-hidden="true">·</span> Home</a>
        <a href="#writing"><span aria-hidden="true">·</span> Writing</a>
        <a href="#projects"><span aria-hidden="true">·</span> Projects</a>
        <a href="#about"><span aria-hidden="true">·</span> About</a>
      </nav>
      <p class="rail-note">A notebook on software,<br />systems, and making.</p>
    </header>

    <main id="home">
      <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow">Personal technical notebook</p>
        <h1 id="page-title">
          <span data-dial-title>William Kiem-Lafond</span> is a
          <em>software engineer</em> drawn to the systems beneath intelligent tools.
        </h1>
        <p class="lede" data-dial-intro>
          Working around applied AI, compilers, infrastructure, and systems. This is a notebook for things I learn by building.
        </p>

        <div class="intro-meta">
          <div>
            <p class="meta-label">Previously</p>
            <p>Machine learning at Shopify.<br />Compiler engineering at Qualcomm.</p>
          </div>
          <blockquote>
            <p>“We think systems, but we also have an eye for aesthetics.”</p>
            <cite>— Vlad, good friend &amp; college roommate</cite>
          </blockquote>
        </div>

        <div class="intro-links" aria-label="Explore">
          <a href="#writing">Read the notebook <span aria-hidden="true">↘</span></a>
          <a href="#projects">Selected work <span aria-hidden="true">↘</span></a>
        </div>
      </section>

      <div class="rule" aria-hidden="true"></div>

      <section class="index-section" id="writing" aria-labelledby="writing-title">
        <div class="section-heading">
          <p class="section-number">01</p>
          <h2 id="writing-title">Writing</h2>
        </div>
        <div class="section-content">
          <p class="section-note">Notes, experiments, and longer explanations.</p>
          <div class="empty-row">
            <span>Notes will appear here</span>
            <span class="dot-leader" aria-hidden="true"></span>
            <span>Index</span>
          </div>
        </div>
      </section>

      <section class="index-section" id="projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <p class="section-number">02</p>
          <h2 id="projects-title">Projects</h2>
        </div>
        <div class="section-content">
          <p class="section-note">Selected engineering work, documented as it develops.</p>
          <div class="empty-row">
            <span>Selected work will appear here</span>
            <span class="dot-leader" aria-hidden="true"></span>
            <span>Index</span>
          </div>
        </div>
      </section>

      <section class="index-section" id="about" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="section-number">03</p>
          <h2 id="about-title">Elsewhere</h2>
        </div>
        <div class="section-content elsewhere-links">
          <span>GitHub</span>
          <span>Email</span>
          <span class="muted">Links pending</span>
        </div>
      </section>
    </main>

    <footer>
      <span>Personal notebook</span>
      <span>Set in <span data-font-label>Georgia + Arial</span></span>
    </footer>
  </div>
</BaseLayout>

<script>
  import { createDialKit, createDialRoot } from 'dialkit/vanilla';
  import 'dialkit/vanilla/styles.css';

  const displayFonts: Record<string, string> = {
    Georgia: "Georgia, 'Times New Roman', serif",
    'Instrument Serif': "'Instrument Serif', Georgia, serif",
    'Libre Baskerville': "'Libre Baskerville', Baskerville, Georgia, serif",
  };

  const bodyFonts: Record<string, string> = {
    Arial: 'Arial, Helvetica, sans-serif',
    'Be Vietnam Pro': "'Be Vietnam Pro', Arial, sans-serif",
    'DM Sans': "'DM Sans', Arial, sans-serif",
  };

  createDialRoot({
    position: 'bottom-right',
    theme: 'light',
    versions: 'thumbnails',
    productionEnabled: true,
  });

  const kit = createDialKit(
    'Landing page',
    {
      Type: {
        display: {
          type: 'select',
          options: ['Georgia', 'Instrument Serif', 'Libre Baskerville'],
        },
        body: {
          type: 'select',
          options: ['Arial', 'Be Vietnam Pro', 'DM Sans'],
        },
        titleSize: [100, 44, 120, 1],
        titleTracking: [2, -6, 4, 0.1],
        bodySize: [16, 12, 20, 1],
        lineHeight: [1.5, 1.1, 2, 0.05],
      },
      Color: {
        paper: '#f4f1e8',
        ink: '#34342f',
        mutedInk: '#74746c',
        accent: '#aab500',
        rule: '#a7a79e',
      },
      Layout: {
        canvasWidth: [1296, 800, 1600, 8],
        pageInset: [34, 16, 96, 2],
        topSpace: [30, 16, 120, 2],
        introTop: [128, 48, 240, 4],
        introWidth: [800, 440, 1040, 10],
        sectionGap: [60, 32, 128, 4],
        navWidth: [196, 140, 300, 2],
      },
      Details: {
        grain: [0.12, 0, 0.16, 0.005],
        grainSize: [96, 48, 220, 4],
        ruleStyle: {
          type: 'select',
          options: ['dashed', 'dotted', 'solid'],
        },
        ruleOpacity: [0.45, 0.1, 1, 0.01],
        verticalRules: true,
        horizontalRules: true,
        edgeRules: true,
        showNumbers: true,
        squareCursor: true,
        cursorSize: [10, 6, 18, 1],
      },
      Copy: {
        title: 'William Kiem-Lafond',
        introduction:
          'Working around applied AI, compilers, infrastructure, and systems. This is a notebook for things I learn by building.',
      },
    },
    { id: 'personal-site-landing-v2', persist: true },
  );

  kit.subscribe((values) => {
    const style = document.documentElement.style;
    const display = displayFonts[values.Type.display] ?? displayFonts.Georgia;
    const body = bodyFonts[values.Type.body] ?? bodyFonts.Arial;

    style.setProperty('--font-display', display);
    style.setProperty('--font-body', body);
    style.setProperty('--color-paper', values.Color.paper);
    style.setProperty('--color-ink', values.Color.ink);
    style.setProperty('--color-ink-muted', values.Color.mutedInk);
    style.setProperty('--color-accent', values.Color.accent);
    style.setProperty('--color-rule-custom', values.Color.rule);
    style.setProperty('--title-size', `${values.Type.titleSize}px`);
    style.setProperty('--title-tracking', `${values.Type.titleTracking}px`);
    style.setProperty('--body-size', `${values.Type.bodySize}px`);
    style.setProperty('--body-leading', String(values.Type.lineHeight));
    style.setProperty('--canvas-width', `${values.Layout.canvasWidth}px`);
    style.setProperty('--page-inset', `${values.Layout.pageInset}px`);
    style.setProperty('--top-space', `${values.Layout.topSpace}px`);
    style.setProperty('--intro-top', `${values.Layout.introTop}px`);
    style.setProperty('--intro-width', `${values.Layout.introWidth}px`);
    style.setProperty('--section-gap', `${values.Layout.sectionGap}px`);
    style.setProperty('--nav-width', `${values.Layout.navWidth}px`);
    style.setProperty('--grain-opacity', String(values.Details.grain));
    style.setProperty('--grain-size', `${values.Details.grainSize}px`);
    style.setProperty('--rule-style', values.Details.ruleStyle);
    style.setProperty('--rule-opacity', String(values.Details.ruleOpacity));

    const cursorSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="${values.Details.cursorSize}" height="${values.Details.cursorSize}"><rect width="100%" height="100%" fill="${values.Color.accent}"/></svg>`;
    style.setProperty('--site-cursor', `url("data:image/svg+xml,${encodeURIComponent(cursorSvg)}")`);

    document.documentElement.dataset.showNumbers = String(values.Details.showNumbers);
    document.documentElement.dataset.verticalRules = String(values.Details.verticalRules);
    document.documentElement.dataset.horizontalRules = String(values.Details.horizontalRules);
    document.documentElement.dataset.edgeRules = String(values.Details.edgeRules);
    document.documentElement.dataset.squareCursor = String(values.Details.squareCursor);

    const title = document.querySelector<HTMLElement>('[data-dial-title]');
    const introduction = document.querySelector<HTMLElement>('[data-dial-intro]');
    const fontLabel = document.querySelector<HTMLElement>('[data-font-label]');
    if (title) title.textContent = values.Copy.title;
    if (introduction) introduction.textContent = values.Copy.introduction;
    if (fontLabel) fontLabel.textContent = `${values.Type.display} + ${values.Type.body}`;
  });
</script>

<style>
  :global(html) {
    --title-size: 100px;
    --title-tracking: 2px;
    --body-size: 16px;
    --body-leading: 1.5;
    --canvas-width: 1296px;
    --page-inset: 34px;
    --top-space: 30px;
    --intro-top: 128px;
    --intro-width: 800px;
    --section-gap: 60px;
    --nav-width: 196px;
    --grain-size: 96px;
    --color-rule-custom: #a7a79e;
    --rule-style: dashed;
    --rule-opacity: 0.45;
    --site-cursor: auto;
    scroll-behavior: smooth;
    font-size: var(--body-size);
  }

  :global(html[data-square-cursor='true']),
  :global(html[data-square-cursor='true'] *) {
    cursor: var(--site-cursor) 5 5, auto;
  }

  :global(::selection) {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  :global(body) {
    min-width: 320px;
    background: var(--color-paper);
  }

  :global(body::before) {
    position: fixed;
    z-index: 10;
    inset: 0;
    pointer-events: none;
    content: '';
    opacity: var(--grain-opacity);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 96 96' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.42'/%3E%3C/svg%3E");
    background-size: var(--grain-size) var(--grain-size);
  }

  .site-shell {
    display: grid;
    grid-template-columns: var(--nav-width) minmax(0, 1fr);
    width: min(100%, var(--canvas-width));
    min-height: 100vh;
    margin-inline: auto;
    border-inline: 1px var(--rule-style) var(--color-rule-custom);
    border-inline-color: color-mix(in srgb, var(--color-rule-custom) calc(var(--rule-opacity) * 100%), transparent);
  }

  :global(html[data-edge-rules='false']) .site-shell {
    border-inline-color: transparent;
  }

  .site-rail {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--top-space) var(--page-inset);
    border-right: 1px var(--rule-style) var(--color-rule-custom);
    border-right-color: color-mix(in srgb, var(--color-rule-custom) calc(var(--rule-opacity) * 100%), transparent);
    font-size: 0.72rem;
  }

  :global(html[data-vertical-rules='false']) .site-rail {
    border-right-color: transparent;
  }

  .name-link {
    color: var(--color-ink-muted);
    line-height: 1.2;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: var(--intro-top);
  }

  nav a {
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  nav a span {
    color: transparent;
  }

  nav a:hover,
  nav a.is-active {
    color: var(--color-accent);
  }

  nav a:hover span,
  nav a.is-active span {
    color: currentColor;
  }

  .rail-note {
    margin: auto 0 0;
    color: var(--color-ink-muted);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-style: italic;
    line-height: 1.35;
  }

  main {
    min-width: 0;
    padding: calc(var(--top-space) + var(--intro-top)) var(--page-inset) 0;
  }

  .intro {
    max-width: var(--intro-width);
  }

  .eyebrow,
  .section-number,
  .meta-label {
    margin: 0 0 var(--space-6);
    color: var(--color-ink-muted);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    margin-right: var(--space-2);
    background: var(--color-accent);
    content: '';
  }

  h1 {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.7vw, var(--title-size));
    font-weight: 400;
    letter-spacing: var(--title-tracking);
    line-height: 0.98;
    text-wrap: balance;
  }

  h1 em {
    color: var(--color-accent);
    font-weight: inherit;
  }

  .lede {
    max-width: 54ch;
    margin: var(--space-8) 0 0;
    color: var(--color-ink-muted);
    line-height: var(--body-leading);
  }

  .intro-meta {
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr) minmax(260px, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px var(--rule-style) var(--color-rule-custom);
    border-top-color: color-mix(in srgb, var(--color-rule-custom) calc(var(--rule-opacity) * 100%), transparent);
    font-size: 0.76rem;
  }

  :global(html[data-horizontal-rules='false']) .intro-meta,
  :global(html[data-horizontal-rules='false']) .rule,
  :global(html[data-horizontal-rules='false']) .index-section {
    border-color: transparent;
  }

  .intro-meta p {
    margin: 0;
    line-height: 1.45;
  }

  .meta-label {
    margin-bottom: var(--space-2) !important;
  }

  blockquote {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 1px var(--rule-style) var(--color-accent);
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
  }

  blockquote cite {
    display: block;
    margin-top: var(--space-3);
    color: var(--color-ink-muted);
    font-size: 0.66rem;
    font-style: normal;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-8);
    font-size: 0.78rem;
  }

  .intro-links a {
    text-decoration: none;
    text-decoration-color: var(--color-accent);
  }

  .intro-links a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .rule {
    margin: var(--section-gap) calc(var(--page-inset) * -1) 0;
    border-top: 1px var(--rule-style) var(--color-rule-custom);
    opacity: var(--rule-opacity);
  }

  .index-section {
    display: grid;
    grid-template-columns: minmax(170px, 0.75fr) 2fr;
    gap: var(--space-8);
    margin-inline: calc(var(--page-inset) * -1);
    padding: var(--space-8) var(--page-inset);
    border-bottom: 1px var(--rule-style) var(--color-rule-custom);
    border-bottom-color: color-mix(in srgb, var(--color-rule-custom) calc(var(--rule-opacity) * 100%), transparent);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 2rem auto;
    align-items: baseline;
  }

  .section-number {
    margin: 0;
    font-size: 0.58rem;
  }

  :global(html[data-show-numbers='false']) .section-number {
    visibility: hidden;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 400;
  }

  .section-note {
    margin: 0 0 var(--space-8);
    color: var(--color-ink-muted);
    font-size: 0.78rem;
  }

  .empty-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: 0.8rem;
  }

  .empty-row > :last-child {
    color: var(--color-ink-muted);
    font-size: 0.66rem;
  }

  .dot-leader {
    height: 1px;
    flex: 1;
    border-top: 1px dotted var(--color-rule-custom);
    opacity: var(--rule-opacity);
  }

  .elsewhere-links {
    display: flex;
    gap: var(--space-8);
    font-size: 0.8rem;
  }

  .muted {
    color: var(--color-ink-muted);
  }

  footer {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-8) var(--page-inset);
    color: var(--color-ink-muted);
    font-size: 0.62rem;
  }

  @media (max-width: 760px) {
    .site-shell {
      display: block;
    }

    .site-rail {
      position: static;
      display: block;
      height: auto;
      padding: var(--top-space) max(18px, var(--page-inset));
      border-right: 0;
      border-bottom: 1px var(--rule-style) var(--color-rule-custom);
    }

    nav {
      flex-direction: row;
      gap: var(--space-4);
      margin-top: var(--space-6);
      overflow-x: auto;
    }

    .rail-note {
      display: none;
    }

    main {
      padding: max(4rem, calc(var(--intro-top) * 0.55)) max(18px, var(--page-inset)) 0;
    }

    h1 {
      font-size: clamp(3rem, 13vw, var(--title-size));
      letter-spacing: min(var(--title-tracking), 1px);
    }

    .intro-meta {
      grid-template-columns: 1fr;
    }

    .index-section {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .elsewhere-links,
    footer {
      flex-wrap: wrap;
    }

    footer {
      grid-column: auto;
      padding-inline: max(18px, var(--page-inset));
    }
  }

  @media (pointer: coarse) {
    :global(html[data-square-cursor='true']),
    :global(html[data-square-cursor='true'] *) {
      cursor: auto;
    }
  }
</style>
